# Server-side configuration. Never commit real credentials.
# Configure credentials in your hosting provider or local environment.
GEMINI_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_BACKUP_MODEL=gemini-2.5-flash
# Optional Google evidence. A search-engine ID enables general web search.
GOOGLE_SEARCH_ENABLED=false
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
PORT=8080
# ALLOWED_ORIGINS=https://your-separate-frontend.example
# VITE_API_URL=https://your-separate-api.example
