# Server-side configuration. Never commit real credentials.
# Configure credentials in your hosting provider or local environment.
GEMINI_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_BACKUP_MODEL=gemini-2.5-flash
WIKIDATA_CONTACT_EMAIL=
# Specialised public evidence sources; no API keys required.
PUBMED_ENABLED=true
WIKIDATA_ENABLED=true
PORT=8080
