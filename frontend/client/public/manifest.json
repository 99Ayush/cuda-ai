{
  "manifest_version": 3,
  "name": "CUDA AI - Fact Checker",
  "version": "3.0",
  "description": "Bring selected claims to CUDA AI for evidence-based fact checking.",
  "permissions": ["sidePanel", "activeTab", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "extension.html"
  },
  "action": {
    "default_title": "Open Cuda AI"
  }
}
