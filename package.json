{
  "name": "claimlens",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node apps/api/dist/index.js",
    "preview:test": "npm run demo",
    "preview:fixtures": "node scripts/test-preview.js --fixtures",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "extension:build": "node scripts/build-extension.js",
    "benchmark": "node scripts/benchmark.js",
    "eval:validate": "node eval/validate-dataset.cjs",
    "e2e": "playwright test",
    "lint": "eslint scripts apps/api/tests apps/api/src packages/shared/src --config eslint.config.js && npm run lint --workspace=@claimlens/web",
    "test": "npm run build:shared && npm run build:api && node scripts/test.cjs",
    "check": "npm run typecheck && npm run test && npm run lint && npm run build",
    "demo": "npm run build && node scripts/demo.cjs",
    "build:shared": "tsc -p packages/shared/tsconfig.json",
    "typecheck": "npm run build:shared && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:api": "npm run build --workspace=@claimlens/api",
    "build:web": "npm run build --workspace=@claimlens/web"
  },
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.25",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "fast-check": "^4.10.3",
    "prettier": "^3.10.1",
    "typescript": "6.0.3"
  }
}
