{
  "name": "cuda-ai",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "backend/api",
    "frontend/client"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start": "node backend/api/index.js",
    "build": "npm run build --workspace=cuda-ai-frontend",
    "lint": "npm run lint --workspace=cuda-ai-frontend",
    "test": "node --test backend/api/tests/engine.test.cjs backend/api/tests/app.test.cjs backend/api/tests/storage.test.cjs",
    "check": "npm run test && npm run lint && npm run build"
  }
}
